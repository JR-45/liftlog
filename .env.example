# Copy to .env.local and fill in. .env.local is ignored by git.
#
# VITE_ variables end up in the public browser bundle, so only values that are
# safe to publish belong here. Data is protected by Row Level Security.
# Never add the service_role / secret key to this file or to any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
